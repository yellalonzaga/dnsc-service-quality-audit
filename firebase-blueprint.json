{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information for staff and faculty at DNSC",
      "type": "object",
      "properties": {
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "office": { "type": "string", "maxLength": 150 },
        "roleCategory": { "type": "string", "enum": ["Faculty", "Program Chair", "Administrative Staff"] },
        "position": { "type": "string", "maxLength": 150 },
        "jobDescription": { "type": "string", "maxLength": 1000 },
        "yearsInRole": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["office", "roleCategory", "position", "jobDescription", "yearsInRole"]
    },
    "Audit": {
      "title": "Audit",
      "description": "A single service quality audit session",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["in_progress", "completed"] },
        "stage": { "type": "number" },
        "answerCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "completedAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "profileSnapshot": { "type": "object" },
        "serviceCard": { "type": "object" }
      },
      "required": ["id", "userId", "status", "stage", "answerCount", "createdAt"]
    },
    "Interaction": {
      "title": "Interaction",
      "description": "A single dialogue turn in the audit interview",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "auditId": { "type": "string", "maxLength": 128 },
        "clientMessageId": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "content": { "type": "string", "maxLength": 2500 },
        "stage": { "type": "number" },
        "timestamp": { "type": "string" },
        "modelUsed": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "auditId", "role", "content", "stage", "timestamp"]
    },
    "ServiceStandards": {
      "title": "ServiceStandards",
      "description": "DNSC uploaded service standards documents in settings/serviceStandards",
      "type": "object",
      "properties": {
        "documents": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["documents"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Privileged administrator designation document in admins/{uid}",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["superadmin"] },
        "createdAt": { "type": "string" }
      },
      "required": ["role"]
    },
    "ScorecardReport": {
      "title": "ScorecardReport",
      "description": "Consolidated quality report generated by admin",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "markdown": { "type": "string" },
        "stats": { "type": "object" },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "title", "markdown", "stats", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document owned by the respective user"
    },
    "/users/{userId}/audits/{auditId}": {
      "schema": "Audit",
      "description": "Audits conducted by the respective user"
    },
    "/users/{userId}/interactions/{interactionId}": {
      "schema": "Interaction",
      "description": "Interview messages recorded under an audit"
    },
    "/settings/serviceStandards": {
      "schema": "ServiceStandards",
      "description": "Global service standards uploaded by admin"
    },
    "/admins/{uid}": {
      "schema": "AdminRecord",
      "description": "Admin designation document"
    },
    "/scorecardReports/{reportId}": {
      "schema": "ScorecardReport",
      "description": "Consolidated scorecard reports saved by admin"
    }
  }
}
